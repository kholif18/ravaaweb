# ============================================================
# RavaaWeb — Environment Configuration
# Copy to .env and adjust for your environment
# ============================================================

APP_NAME=RavaaWeb
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Database (MariaDB)
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=web
DB_USERNAME=root
DB_PASSWORD=

# Redis (cache & session)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis

# Mail
MAIL_MAILER=log

# Queue
QUEUE_CONNECTION=database

# Filesystem
FILESYSTEM_DISK=local
