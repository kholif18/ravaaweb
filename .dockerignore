# Dependencies (installed in stages, not copied from host)
/vendor
/node_modules

# Environment
.env
.env.*
!.env.example

# Cache
bootstrap/cache/*
!bootstrap/cache/.gitkeep

# Storage
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
storage/debugbar/*
storage/app/public/*

# Git
.git
.gitignore
.gitattributes

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Tests
tests/
phpunit.xml
phpunit.xml.dist

# Docker (don't copy docker files into image)
Dockerfile*
docker-compose*
.dockerignore

# Node
node_modules/
package-lock.json
yarn.lock

# Documentation
*.md
LICENSE
